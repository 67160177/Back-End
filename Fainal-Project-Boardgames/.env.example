# ===== API Gateway (จุดเข้าถึงเดียวของ client) =====
PORT=3000
NODE_ENV=development
ALLOWED_ORIGIN=*

# URL ของ service ภายในที่ Gateway ส่งต่อคำขอไป
BOARDGAME_SERVICE_URL=http://localhost:4001
NOTIFICATION_SERVICE_URL=http://localhost:4002
AUTH_SERVICE_URL=http://localhost:4003

# เวลาสูงสุดที่ Gateway รอ service (ต้องมากกว่าเวลาแย่สุดของ POST /boardgames ~7.6 วินาที)
GATEWAY_TIMEOUT_MS=10000

# Rate limiting (สัปดาห์ที่ 12) นับแยกตาม IP เกินแล้วได้ 429 / ตั้ง MAX=0 = ปิด (เช่นระหว่างซ้อม demo)
# /api/v1/* ทั้งหมด (ยกเว้น /api/v1/health)
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
# /api/v1/auth/login และ /register (กันการเดารหัสผ่าน)
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000

# ===== boardgame-service =====
BOARDGAME_PORT=4001

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=boardgame_db

# Cache ผลของ GET (สัปดาห์ที่ 7) ล้างทันทีเมื่อมีการเพิ่ม/แก้ไข/ลบ / ตั้ง 0 = ปิด
CACHE_TTL_MS=30000

# การเรียก notification-service (ใช้ NOTIFICATION_SERVICE_URL ด้านบน)
EXTERNAL_API_TIMEOUT_MS=2000
EXTERNAL_API_MAX_RETRIES=2
EXTERNAL_API_RETRY_DELAY_MS=500

# ===== notification-service =====
NOTIFICATION_PORT=4002

# Discord Webhook (ถ้าไม่ตั้งค่า จะข้ามการแจ้งเตือน และ boardgame-service ใช้ fallback)
DISCORD_WEBHOOK_URL=

# เวลาสูงสุดที่รอ Discord ต่อ 1 ครั้ง (ควรน้อยกว่า EXTERNAL_API_TIMEOUT_MS)
DISCORD_TIMEOUT_MS=1500

# ===== auth-service =====
AUTH_PORT=4003

# กุญแจลงชื่อ JWT ใช้ร่วมกันระหว่าง auth-service (ออก token) และ Gateway (ตรวจ token)
# ต้องตั้งเอง เป็นข้อความสุ่มยาวๆ เช่น: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ถ้าไม่ตั้ง: เข้าสู่ระบบและการเพิ่ม/แก้ไข/ลบจะได้ 503 AUTH_NOT_CONFIGURED
JWT_SECRET=
JWT_EXPIRES_IN=2h

# บัญชี admin หลัก: ตอนเปิด auth-service จะสร้างบัญชีนี้เป็น admin (ถ้ามีแล้วจะตั้งเป็น admin และใช้รหัสตามนี้)
# username 3-30 ตัว (a-z, A-Z, 0-9, _) / รหัสผ่าน 8-72 ตัว / ไม่ใส่ = ไม่สร้าง (ใช้ npm run create-admin แทนได้)
ADMIN_USERNAME=
ADMIN_PASSWORD=
