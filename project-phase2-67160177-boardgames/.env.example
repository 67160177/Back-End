# Server
PORT=3000
NODE_ENV=development
ALLOWED_ORIGIN=*

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=boardgame_db

# External API: Discord Webhook (ถ้าไม่ตั้งค่า ระบบจะข้ามการแจ้งเตือนและใช้ fallback)
DISCORD_WEBHOOK_URL=

# ค่าความทนทานของการเรียก API ภายนอก (ไม่ตั้งก็ได้ จะใช้ค่า default)
EXTERNAL_API_TIMEOUT_MS=2000
EXTERNAL_API_MAX_RETRIES=2
EXTERNAL_API_RETRY_DELAY_MS=500
