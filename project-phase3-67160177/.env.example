# Server
PORT=3000
NODE_ENV=development
ALLOWED_ORIGIN=*

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=boardgame_db

# ===== API หลัก -> notification-service =====
# URL ของ notification-service ที่ API หลักเรียก
NOTIFICATION_SERVICE_URL=http://localhost:3001

# ค่าความทนทานของการเรียก service ภายนอก (ไม่ตั้งก็ได้ จะใช้ค่า default)
EXTERNAL_API_TIMEOUT_MS=2000
EXTERNAL_API_MAX_RETRIES=2
EXTERNAL_API_RETRY_DELAY_MS=500

# ===== notification-service (microservice) =====
NOTIFICATION_PORT=3001

# Discord Webhook (ถ้าไม่ตั้งค่า จะข้ามการแจ้งเตือน และ API หลักใช้ fallback)
DISCORD_WEBHOOK_URL=

# เวลาสูงสุดที่ notification-service รอ Discord ต่อ 1 ครั้ง (ควรน้อยกว่า EXTERNAL_API_TIMEOUT_MS)
DISCORD_TIMEOUT_MS=1500
